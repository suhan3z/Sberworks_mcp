# Jira / Confluence / Bitbucket endpoints
JIRA_BASE_URL=https://jira.example.com
CONFLUENCE_BASE_URL=https://sberworks.ru/wiki
BITBUCKET_BASE_URL=https://git.example.com/bitbucket

# Shared basic auth. Used for Jira, Confluence and Bitbucket fallback.
AUTH_USERNAME=
AUTH_PASSWORD=

# Optional Bitbucket bearer token. If set, it takes precedence for Bitbucket.
BITBUCKET_SERVER_BEARER_TOKEN=

# Optional corporate TLS settings.
REQUESTS_CA_BUNDLE=
CLIENT_P12_PATH=cert/client.p12
CLIENT_P12_PASSWORD=

# Mutating MCP tools are disabled unless this is true.
SBERWORKS_MCP_ENABLE_WRITES=false

# HTTP behavior
SBERWORKS_MCP_TIMEOUT_SECONDS=30
