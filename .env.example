# Required Jira / Confluence / Bitbucket endpoints.
JIRA_BASE_URL=https://jira.example.com
CONFLUENCE_BASE_URL=https://sberworks.ru/wiki
BITBUCKET_BASE_URL=https://git.example.com/bitbucket

# Required shared basic auth.
# Used for Jira, Confluence and Bitbucket fallback.
AUTH_USERNAME=
AUTH_PASSWORD=

# Optional Bitbucket bearer token.
# If set, it takes precedence over basic auth for Bitbucket only.
BITBUCKET_SERVER_BEARER_TOKEN=

# Optional corporate TLS settings.
# Use absolute paths when this server is launched by an MCP client.
REQUESTS_CA_BUNDLE=
CLIENT_P12_PATH=
CLIENT_P12_PASSWORD=

# Mutating MCP tools are disabled unless this is true.
# Keep false for the first read-only launch.
SBERWORKS_MCP_ENABLE_WRITES=false

# HTTP request timeout in seconds.
SBERWORKS_MCP_TIMEOUT_SECONDS=30
